// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Jogo {
  id          Int              @id @default(autoincrement())
  titulo      String
  personagens PERSONAGEM[]
  conquistas  CONQUISTA[]
  plataformas Jogoplataforma[]
}

model PERSONAGEM {
  id        Int    @id @default(autoincrement())
  nome      String
  jogo      Jogo   @relation(fields: [jogoId], references: [id])
  jogoId    Int
  atributos Json
}

model plataforma {
  id   Int              @id @default(autoincrement())
  nome String
  jogo Jogoplataforma[]
}

model CONQUISTA {
  id        Int    @id @default(autoincrement())
  titulo    String
  jogo      Jogo   @relation(fields: [jogoId], references: [id])
  jogoId    Int
  descricao String
}

model Jogoplataforma {
  jogo         Jogo       @relation(fields: [jogoId], references: [id], onDelete: Cascade)
  jogoId       Int
  plataforma   plataforma @relation(fields: [plataformaId], references: [id], onDelete: Cascade)
  plataformaId Int
  lancamento   String?

  @@id([jogoId, plataformaId])
}

model Perfil {
  id          Int           @id @default(autoincrement())
  name        String
  titulo      String?
  titule      String?
  projetos    Projeto[]
  certificado Certificado[]
}

model Projeto {
  id       Int    @id @default(autoincrement())
  nome     String
  perfil   Perfil @relation(fields: [perfilId], references: [id])
  perfilId Int
}

model Certificado {
  id       Int    @id @default(autoincrement())
  nome     String
  perfil   Perfil @relation(fields: [perfilId], references: [id])
  perfilId Int
}

